# Backend secrets. Copy to .env.local for local dev; set the same keys on Coolify. Never commit values.
GOOGLE_MAPS_API_KEY=
ANTHROPIC_API_KEY=

# The shared key /api asks every caller for, matching EXPO_PUBLIC_API_KEY in the app. Any long random string:
# `openssl rand -hex 32`. Leave it unset and /api stays open to anyone who knows the URL.
FIKA_API_KEY=

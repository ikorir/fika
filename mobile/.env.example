# The deployed backend. The app never talks to a laptop.
EXPO_PUBLIC_API_URL=https://fika-api.isakolabs.com

# Android only: a Google Maps SDK for Android key, read by app.config.js when the app is built.
# Without it the Android map draws a blank grid. iOS uses Apple Maps and needs no key.
# For an EAS Android build, set the same name as an EAS environment variable: .env is not uploaded.
GOOGLE_MAPS_ANDROID_KEY=
